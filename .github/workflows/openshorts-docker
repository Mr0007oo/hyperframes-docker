name: Build Upstream openshorts Multi-Arch

on:
  workflow_dispatch:
  schedule:
    - cron: '0 2 * * *' # Checks upstream daily at 2:00 UTC for new updates
  push:
    tags:
      - 'v*.*.*'

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: mr0007oo/openshorts

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout Upstream Openshorts Repository
        uses: actions/checkout@v4
        with:
          repository: mutonby/openshorts
          ref: main # Adjust if upstream uses 'master'

      - name: Set up QEMU (for cross-platform ARM64 builds)
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to the Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata (tags, labels) for Docker
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=raw,value=latest,enable={{is_default_branch}}
            type=ref,event=tag
            type=sha,prefix=sha-,format=short

      - name: Build and push Docker image
        id: push
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

      - name: Echo Image Name and Metadata
        run: |
          echo "Successfully built and published upstream openshorts image!"
          echo "Image Name: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}"
          echo "Generated Tags:"
          echo "${{ steps.meta.outputs.tags }}"
